{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AssetBrowser",
  "version": "0.1.0",
  "identifier": "com.assetbrowser.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "素材浏览器",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#0c0c0e",
        "dragDropEnabled": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}